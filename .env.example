DATABASE_URL="postgresql://postgres:123@localhost:5433/jobconnect?schema=public"

OTP_PEPPER="replace-with-at-least-32-characters"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

BCRYPT_SALT_ROUNDS=12

JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900

SEED_ADMIN_EMAIL="admin@jobconnect.local"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@123456"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FORCE_IPV4=false
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="JobConnect"
SMTP_FROM_EMAIL="your-email@example.com"
