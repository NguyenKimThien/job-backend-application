generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VaiTroTaiKhoan {
  NGUOI_LAO_DONG
  NHA_TUYEN_DUNG
  QUAN_TRI_VIEN
}

enum TrangThaiTaiKhoan {
  CHO_XAC_THUC_EMAIL
  HOAT_DONG
  TAM_KHOA
  DA_KHOA
}

enum MucDichMaXacThuc {
  DANG_KY
  QUEN_MAT_KHAU
  DOI_EMAIL
}

enum GioiTinh {
  NAM
  NU
  KHAC
}

enum TrangThaiTimViec {
  DANG_TIM_VIEC
  TAM_DUNG_TIM_VIEC
  DA_CO_VIEC
}

enum MucDoKyNang {
  CO_BAN
  TRUNG_BINH
  KHA
  THANH_THAO
  CHUYEN_GIA
}

enum TrangThaiKiemDuyet {
  BAN_NHAP
  CHO_DUYET
  DA_DUYET
  TU_CHOI
  YEU_CAU_BO_SUNG
}

enum HinhThucLamViec {
  TOAN_THOI_GIAN
  BAN_THOI_GIAN
  THUC_TAP
  THOI_VU
  TU_XA
}

enum TrangThaiHienThiTin {
  CHUA_DANG
  DANG_HIEN_THI
  TAM_AN
  DA_DONG
  HET_HAN
}

enum TrangThaiUngTuyen {
  DA_NOP
  DA_XEM
  DUOC_CHON_SO_BO
  MOI_PHONG_VAN
  DA_PHONG_VAN
  TRUNG_TUYEN
  KHONG_PHU_HOP
  DA_RUT
}

enum LoaiDoiTuongKiemDuyet {
  NHA_TUYEN_DUNG
  TIN_TUYEN_DUNG
}

enum LoaiThongBao {
  HE_THONG
  TAI_KHOAN
  KIEM_DUYET
  TUYEN_DUNG
  UNG_TUYEN
}

model TaiKhoan {
  id                       Int                       @id @default(autoincrement()) @map("id")
  tenDangNhap              String                    @unique @map("ten_dang_nhap") @db.VarChar(100)
  email                    String                    @unique @map("email") @db.VarChar(255)
  soDienThoai              String?                   @unique @map("so_dien_thoai") @db.VarChar(20)
  matKhauHash              String                    @map("mat_khau_hash") @db.VarChar(255)
  vaiTro                   VaiTroTaiKhoan            @map("vai_tro")
  trangThaiTaiKhoan        TrangThaiTaiKhoan         @default(CHO_XAC_THUC_EMAIL) @map("trang_thai_tai_khoan")
  emailXacThucLuc          DateTime?                 @map("email_xac_thuc_luc") @db.Timestamptz(6)
  lanDangNhapCuoi          DateTime?                 @map("lan_dang_nhap_cuoi") @db.Timestamptz(6)
  ngayTao                  DateTime                  @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  ngayCapNhat              DateTime                  @updatedAt @map("ngay_cap_nhat") @db.Timestamptz(6)
  maXacThucs               MaXacThuc[]
  hoSoNguoiLaoDong         HoSoNguoiLaoDong?
  hoSoNhaTuyenDung         HoSoNhaTuyenDung?
  thongBaos                ThongBao[]
  lichSuTrangThaiUngTuyens LichSuTrangThaiUngTuyen[] @relation("NguoiThucHienTrangThaiUngTuyen")
  lichSuKiemDuyets         LichSuKiemDuyet[]         @relation("NguoiThucHienKiemDuyet")

  @@index([vaiTro], map: "idx_tai_khoan_vai_tro")
  @@index([trangThaiTaiKhoan], map: "idx_tai_khoan_trang_thai")
  @@map("tai_khoan")
}

model MaXacThuc {
  id            Int              @id @default(autoincrement()) @map("id")
  taiKhoanId    Int              @map("tai_khoan_id")
  maXacThucHash String           @map("ma_xac_thuc_hash") @db.VarChar(255)
  mucDich       MucDichMaXacThuc @map("muc_dich")
  hanSuDung     DateTime         @map("han_su_dung") @db.Timestamptz(6)
  soLanThu      Int              @default(0) @map("so_lan_thu")
  daSuDung      Boolean          @default(false) @map("da_su_dung")
  ngayTao       DateTime         @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  taiKhoan      TaiKhoan         @relation(fields: [taiKhoanId], references: [id], onDelete: Cascade)

  @@index([taiKhoanId, mucDich, daSuDung], map: "idx_ma_xac_thuc_tai_khoan_muc_dich_da_su_dung")
  @@index([hanSuDung], map: "idx_ma_xac_thuc_han_su_dung")
  @@map("ma_xac_thuc")
}

model HoSoNguoiLaoDong {
  id                  Int                 @id @default(autoincrement()) @map("id")
  taiKhoanId          Int                 @unique @map("tai_khoan_id")
  hoTen               String              @map("ho_ten") @db.VarChar(255)
  ngaySinh            DateTime?           @map("ngay_sinh") @db.Date
  gioiTinh            GioiTinh?           @map("gioi_tinh")
  diaChi              String?             @map("dia_chi") @db.Text
  anhDaiDienUrl       String?             @map("anh_dai_dien_url") @db.Text
  gioiThieuBanThan    String?             @map("gioi_thieu_ban_than") @db.Text
  mucLuongMongMuonTu  Decimal?            @map("muc_luong_mong_muon_tu") @db.Decimal(15, 2)
  mucLuongMongMuonDen Decimal?            @map("muc_luong_mong_muon_den") @db.Decimal(15, 2)
  diaDiemMongMuon     String?             @map("dia_diem_mong_muon") @db.Text
  tepCvUrl            String?             @map("tep_cv_url") @db.Text
  trangThaiTimViec    TrangThaiTimViec    @default(DANG_TIM_VIEC) @map("trang_thai_tim_viec")
  ngayTao             DateTime            @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  ngayCapNhat         DateTime            @updatedAt @map("ngay_cap_nhat") @db.Timestamptz(6)
  taiKhoan            TaiKhoan            @relation(fields: [taiKhoanId], references: [id], onDelete: Restrict)
  hocVans             HocVan[]
  kinhNghiemLamViecs  KinhNghiemLamViec[]
  hoSoKyNangs         HoSoKyNang[]
  ungTuyens           UngTuyen[]
  tinTuyenDungDaLuu   TinTuyenDungDaLuu[]

  @@index([trangThaiTimViec], map: "idx_ho_so_nguoi_lao_dong_trang_thai")
  @@map("ho_so_nguoi_lao_dong")
}

model HocVan {
  id                 Int              @id @default(autoincrement()) @map("id")
  hoSoNguoiLaoDongId Int              @map("ho_so_nguoi_lao_dong_id")
  trinhDo            String           @map("trinh_do") @db.VarChar(150)
  tenCoSoDaoTao      String           @map("ten_co_so_dao_tao") @db.VarChar(255)
  chuyenNganh        String?          @map("chuyen_nganh") @db.VarChar(255)
  namBatDau          Int              @map("nam_bat_dau")
  namTotNghiep       Int?             @map("nam_tot_nghiep")
  dangHoc            Boolean          @default(false) @map("dang_hoc")
  xepLoai            String?          @map("xep_loai") @db.VarChar(100)
  hoSoNguoiLaoDong   HoSoNguoiLaoDong @relation(fields: [hoSoNguoiLaoDongId], references: [id], onDelete: Cascade)

  @@index([hoSoNguoiLaoDongId], map: "idx_hoc_van_ho_so_nguoi_lao_dong_id")
  @@map("hoc_van")
}

model KinhNghiemLamViec {
  id                 Int              @id @default(autoincrement()) @map("id")
  hoSoNguoiLaoDongId Int              @map("ho_so_nguoi_lao_dong_id")
  tenDonVi           String           @map("ten_don_vi") @db.VarChar(255)
  viTriCongViec      String           @map("vi_tri_cong_viec") @db.VarChar(255)
  ngayBatDau         DateTime         @map("ngay_bat_dau") @db.Date
  ngayKetThuc        DateTime?        @map("ngay_ket_thuc") @db.Date
  dangLamViec        Boolean          @default(false) @map("dang_lam_viec")
  moTaCongViec       String?          @map("mo_ta_cong_viec") @db.Text
  hoSoNguoiLaoDong   HoSoNguoiLaoDong @relation(fields: [hoSoNguoiLaoDongId], references: [id], onDelete: Cascade)

  @@index([hoSoNguoiLaoDongId], map: "idx_kinh_nghiem_ho_so_nguoi_lao_dong_id")
  @@map("kinh_nghiem_lam_viec")
}

model KyNang {
  id                  Int                  @id @default(autoincrement()) @map("id")
  tenKyNang           String               @unique @map("ten_ky_nang") @db.VarChar(150)
  moTa                String?              @map("mo_ta") @db.Text
  trangThaiHienThi    Boolean              @default(true) @map("trang_thai_hien_thi")
  hoSoKyNangs         HoSoKyNang[]
  tinTuyenDungKyNangs TinTuyenDungKyNang[]

  @@map("ky_nang")
}

model HoSoKyNang {
  hoSoNguoiLaoDongId Int              @map("ho_so_nguoi_lao_dong_id")
  kyNangId           Int              @map("ky_nang_id")
  mucDoThanhThao     MucDoKyNang      @map("muc_do_thanh_thao")
  soNamKinhNghiem    Decimal          @default(0) @map("so_nam_kinh_nghiem") @db.Decimal(4, 1)
  hoSoNguoiLaoDong   HoSoNguoiLaoDong @relation(fields: [hoSoNguoiLaoDongId], references: [id], onDelete: Cascade)
  kyNang             KyNang           @relation(fields: [kyNangId], references: [id], onDelete: Restrict)

  @@id([hoSoNguoiLaoDongId, kyNangId])
  @@index([kyNangId], map: "idx_ho_so_ky_nang_ky_nang_id")
  @@map("ho_so_ky_nang")
}

model LinhVuc {
  id                Int                @id @default(autoincrement()) @map("id")
  tenLinhVuc        String             @unique @map("ten_linh_vuc") @db.VarChar(255)
  moTa              String?            @map("mo_ta") @db.Text
  trangThaiHienThi  Boolean            @default(true) @map("trang_thai_hien_thi")
  hoSoNhaTuyenDungs HoSoNhaTuyenDung[]

  @@map("linh_vuc")
}

model HoSoNhaTuyenDung {
  id                 Int                @id @default(autoincrement()) @map("id")
  taiKhoanId         Int                @unique @map("tai_khoan_id")
  linhVucId          Int?               @map("linh_vuc_id")
  tenDonVi           String             @map("ten_don_vi") @db.VarChar(255)
  maSoThue           String             @unique @map("ma_so_thue") @db.VarChar(50)
  diaChiTruSo        String             @map("dia_chi_tru_so") @db.Text
  nguoiDaiDien       String?            @map("nguoi_dai_dien") @db.VarChar(255)
  chucVuNguoiDaiDien String?            @map("chuc_vu_nguoi_dai_dien") @db.VarChar(150)
  soDienThoaiLienHe  String?            @map("so_dien_thoai_lien_he") @db.VarChar(20)
  emailLienHe        String?            @map("email_lien_he") @db.VarChar(255)
  website            String?            @map("website") @db.Text
  logoUrl            String?            @map("logo_url") @db.Text
  moTaDonVi          String?            @map("mo_ta_don_vi") @db.Text
  tepGiayPhepUrl     String?            @map("tep_giay_phep_url") @db.Text
  trangThaiDuyet     TrangThaiKiemDuyet @default(BAN_NHAP) @map("trang_thai_duyet")
  lyDoTuChoi         String?            @map("ly_do_tu_choi") @db.Text
  ngayGuiDuyet       DateTime?          @map("ngay_gui_duyet") @db.Timestamptz(6)
  ngayDuyet          DateTime?          @map("ngay_duyet") @db.Timestamptz(6)
  ngayTao            DateTime           @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  ngayCapNhat        DateTime           @updatedAt @map("ngay_cap_nhat") @db.Timestamptz(6)
  taiKhoan           TaiKhoan           @relation(fields: [taiKhoanId], references: [id], onDelete: Restrict)
  linhVuc            LinhVuc?           @relation(fields: [linhVucId], references: [id], onDelete: Restrict)
  tinTuyenDungs      TinTuyenDung[]
  lichSuKiemDuyets   LichSuKiemDuyet[]

  @@index([linhVucId], map: "idx_ho_so_nha_tuyen_dung_linh_vuc_id")
  @@index([trangThaiDuyet], map: "idx_ho_so_nha_tuyen_dung_trang_thai_duyet")
  @@map("ho_so_nha_tuyen_dung")
}

model NganhNghe {
  id               Int            @id @default(autoincrement()) @map("id")
  tenNganhNghe     String         @unique @map("ten_nganh_nghe") @db.VarChar(255)
  moTa             String?        @map("mo_ta") @db.Text
  trangThaiHienThi Boolean        @default(true) @map("trang_thai_hien_thi")
  ngayTao          DateTime       @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  ngayCapNhat      DateTime       @updatedAt @map("ngay_cap_nhat") @db.Timestamptz(6)
  tinTuyenDungs    TinTuyenDung[]

  @@map("nganh_nghe")
}

model TinTuyenDung {
  id                      Int                  @id @default(autoincrement()) @map("id")
  nhaTuyenDungId          Int                  @map("nha_tuyen_dung_id")
  nganhNgheId             Int                  @map("nganh_nghe_id")
  viTriTuyenDung          String               @map("vi_tri_tuyen_dung") @db.VarChar(255)
  moTaCongViec            String               @map("mo_ta_cong_viec") @db.Text
  yeuCauUngVien           String               @map("yeu_cau_ung_vien") @db.Text
  quyenLoi                String?              @map("quyen_loi") @db.Text
  mucLuongTu              Decimal?             @map("muc_luong_tu") @db.Decimal(15, 2)
  mucLuongDen             Decimal?             @map("muc_luong_den") @db.Decimal(15, 2)
  coTheThoaThuan          Boolean              @default(false) @map("co_the_thoa_thuan")
  diaDiemLamViec          String               @map("dia_diem_lam_viec") @db.Text
  hinhThucLamViec         HinhThucLamViec      @map("hinh_thuc_lam_viec")
  soLuongTuyen            Int                  @default(1) @map("so_luong_tuyen")
  soNamKinhNghiemToiThieu Decimal?             @map("so_nam_kinh_nghiem_toi_thieu") @db.Decimal(4, 1)
  trinhDoYeuCau           String?              @map("trinh_do_yeu_cau") @db.VarChar(150)
  thoiHanNhanHoSo         DateTime             @map("thoi_han_nhan_ho_so") @db.Timestamptz(6)
  trangThaiKiemDuyet      TrangThaiKiemDuyet   @default(BAN_NHAP) @map("trang_thai_kiem_duyet")
  trangThaiHienThi        TrangThaiHienThiTin  @default(CHUA_DANG) @map("trang_thai_hien_thi")
  lyDoTuChoi              String?              @map("ly_do_tu_choi") @db.Text
  ngayGuiDuyet            DateTime?            @map("ngay_gui_duyet") @db.Timestamptz(6)
  ngayDuyet               DateTime?            @map("ngay_duyet") @db.Timestamptz(6)
  ngayDang                DateTime?            @map("ngay_dang") @db.Timestamptz(6)
  ngayTao                 DateTime             @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  ngayCapNhat             DateTime             @updatedAt @map("ngay_cap_nhat") @db.Timestamptz(6)
  nhaTuyenDung            HoSoNhaTuyenDung     @relation(fields: [nhaTuyenDungId], references: [id], onDelete: Restrict)
  nganhNghe               NganhNghe            @relation(fields: [nganhNgheId], references: [id], onDelete: Restrict)
  tinTuyenDungKyNangs     TinTuyenDungKyNang[]
  ungTuyens               UngTuyen[]
  lichSuKiemDuyets        LichSuKiemDuyet[]
  nguoiLaoDongDaLuu       TinTuyenDungDaLuu[]

  @@index([nhaTuyenDungId], map: "idx_tin_tuyen_dung_nha_tuyen_dung_id")
  @@index([nganhNgheId], map: "idx_tin_tuyen_dung_nganh_nghe_id")
  @@index([trangThaiKiemDuyet], map: "idx_tin_tuyen_dung_trang_thai_kiem_duyet")
  @@index([trangThaiHienThi], map: "idx_tin_tuyen_dung_trang_thai_hien_thi")
  @@index([thoiHanNhanHoSo], map: "idx_tin_tuyen_dung_thoi_han_nhan_ho_so")
  @@index([ngayTao], map: "idx_tin_tuyen_dung_ngay_tao")
  @@index([trangThaiHienThi, thoiHanNhanHoSo, ngayTao], map: "idx_tin_tuyen_dung_dang_hien_thi")
  @@map("tin_tuyen_dung")
}

model TinTuyenDungKyNang {
  tinTuyenDungId Int          @map("tin_tuyen_dung_id")
  kyNangId       Int          @map("ky_nang_id")
  mucDoYeuCau    MucDoKyNang  @map("muc_do_yeu_cau")
  batBuoc        Boolean      @default(false) @map("bat_buoc")
  tinTuyenDung   TinTuyenDung @relation(fields: [tinTuyenDungId], references: [id], onDelete: Cascade)
  kyNang         KyNang       @relation(fields: [kyNangId], references: [id], onDelete: Restrict)

  @@id([tinTuyenDungId, kyNangId])
  @@index([kyNangId], map: "idx_tin_tuyen_dung_ky_nang_ky_nang_id")
  @@map("tin_tuyen_dung_ky_nang")
}

model UngTuyen {
  id                       Int                       @id @default(autoincrement()) @map("id")
  hoSoNguoiLaoDongId       Int                       @map("ho_so_nguoi_lao_dong_id")
  tinTuyenDungId           Int                       @map("tin_tuyen_dung_id")
  hoTenSnapshot            String                    @map("ho_ten_snapshot") @db.VarChar(255)
  emailSnapshot            String                    @map("email_snapshot") @db.VarChar(255)
  soDienThoaiSnapshot      String?                   @map("so_dien_thoai_snapshot") @db.VarChar(20)
  tepCvSnapshotUrl         String?                   @map("tep_cv_snapshot_url") @db.Text
  thuGioiThieu             String?                   @map("thu_gioi_thieu") @db.Text
  trangThaiHienTai         TrangThaiUngTuyen         @default(DA_NOP) @map("trang_thai_hien_tai")
  lyDoTuChoi               String?                   @map("ly_do_tu_choi") @db.Text
  ngayNop                  DateTime                  @default(now()) @map("ngay_nop") @db.Timestamptz(6)
  ngayCapNhatTrangThai     DateTime                  @default(now()) @map("ngay_cap_nhat_trang_thai") @db.Timestamptz(6)
  hoSoNguoiLaoDong         HoSoNguoiLaoDong          @relation(fields: [hoSoNguoiLaoDongId], references: [id], onDelete: Restrict)
  tinTuyenDung             TinTuyenDung              @relation(fields: [tinTuyenDungId], references: [id], onDelete: Restrict)
  lichSuTrangThaiUngTuyens LichSuTrangThaiUngTuyen[]

  @@unique([hoSoNguoiLaoDongId, tinTuyenDungId], map: "uq_ung_tuyen_ho_so_tin")
  @@index([hoSoNguoiLaoDongId], map: "idx_ung_tuyen_ho_so_nguoi_lao_dong_id")
  @@index([tinTuyenDungId], map: "idx_ung_tuyen_tin_tuyen_dung_id")
  @@index([tinTuyenDungId, trangThaiHienTai], map: "idx_ung_tuyen_tin_trang_thai")
  @@index([ngayNop], map: "idx_ung_tuyen_ngay_nop")
  @@map("ung_tuyen")
}

model TinTuyenDungDaLuu {
  hoSoNguoiLaoDongId Int              @map("ho_so_nguoi_lao_dong_id")
  tinTuyenDungId     Int              @map("tin_tuyen_dung_id")
  ngayLuu            DateTime         @default(now()) @map("ngay_luu") @db.Timestamptz(6)
  hoSoNguoiLaoDong   HoSoNguoiLaoDong @relation(fields: [hoSoNguoiLaoDongId], references: [id], onDelete: Cascade)
  tinTuyenDung       TinTuyenDung     @relation(fields: [tinTuyenDungId], references: [id], onDelete: Cascade)

  @@id([hoSoNguoiLaoDongId, tinTuyenDungId])
  @@index([tinTuyenDungId], map: "idx_tin_da_luu_tin_tuyen_dung_id")
  @@map("tin_tuyen_dung_da_luu")
}

model LichSuTrangThaiUngTuyen {
  id              Int                @id @default(autoincrement()) @map("id")
  ungTuyenId      Int                @map("ung_tuyen_id")
  nguoiThucHienId Int?               @map("nguoi_thuc_hien_id")
  trangThaiTruoc  TrangThaiUngTuyen? @map("trang_thai_truoc")
  trangThaiSau    TrangThaiUngTuyen  @map("trang_thai_sau")
  ghiChu          String?            @map("ghi_chu") @db.Text
  ngayThayDoi     DateTime           @default(now()) @map("ngay_thay_doi") @db.Timestamptz(6)
  ungTuyen        UngTuyen           @relation(fields: [ungTuyenId], references: [id], onDelete: Restrict)
  nguoiThucHien   TaiKhoan?          @relation("NguoiThucHienTrangThaiUngTuyen", fields: [nguoiThucHienId], references: [id], onDelete: SetNull)

  @@index([ungTuyenId, ngayThayDoi], map: "idx_lich_su_trang_thai_ung_tuyen_ngay")
  @@index([nguoiThucHienId], map: "idx_lich_su_trang_thai_nguoi_thuc_hien_id")
  @@map("lich_su_trang_thai_ung_tuyen")
}

model LichSuKiemDuyet {
  id                 Int                   @id @default(autoincrement()) @map("id")
  nguoiKiemDuyetId   Int                   @map("nguoi_kiem_duyet_id")
  loaiDoiTuong       LoaiDoiTuongKiemDuyet @map("loai_doi_tuong")
  hoSoNhaTuyenDungId Int?                  @map("ho_so_nha_tuyen_dung_id")
  tinTuyenDungId     Int?                  @map("tin_tuyen_dung_id")
  trangThaiTruoc     TrangThaiKiemDuyet?   @map("trang_thai_truoc")
  trangThaiSau       TrangThaiKiemDuyet    @map("trang_thai_sau")
  lyDo               String?               @map("ly_do") @db.Text
  ngayThucHien       DateTime              @default(now()) @map("ngay_thuc_hien") @db.Timestamptz(6)
  nguoiKiemDuyet     TaiKhoan              @relation("NguoiThucHienKiemDuyet", fields: [nguoiKiemDuyetId], references: [id], onDelete: Restrict)
  hoSoNhaTuyenDung   HoSoNhaTuyenDung?     @relation(fields: [hoSoNhaTuyenDungId], references: [id], onDelete: Restrict)
  tinTuyenDung       TinTuyenDung?         @relation(fields: [tinTuyenDungId], references: [id], onDelete: Restrict)

  @@index([nguoiKiemDuyetId], map: "idx_lich_su_kiem_duyet_nguoi_kiem_duyet_id")
  @@index([hoSoNhaTuyenDungId, ngayThucHien], map: "idx_lich_su_kiem_duyet_ho_so_ntd_ngay")
  @@index([tinTuyenDungId, ngayThucHien], map: "idx_lich_su_kiem_duyet_tin_ngay")
  @@map("lich_su_kiem_duyet")
}

model ThongBao {
  id           Int          @id @default(autoincrement()) @map("id")
  taiKhoanId   Int          @map("tai_khoan_id")
  tieuDe       String       @map("tieu_de") @db.VarChar(255)
  noiDung      String       @map("noi_dung") @db.Text
  loaiThongBao LoaiThongBao @map("loai_thong_bao")
  duongDanDich String?      @map("duong_dan_dich") @db.Text
  daDoc        Boolean      @default(false) @map("da_doc")
  ngayDoc      DateTime?    @map("ngay_doc") @db.Timestamptz(6)
  ngayTao      DateTime     @default(now()) @map("ngay_tao") @db.Timestamptz(6)
  taiKhoan     TaiKhoan     @relation(fields: [taiKhoanId], references: [id], onDelete: Cascade)

  @@index([taiKhoanId, daDoc, ngayTao], map: "idx_thong_bao_tai_khoan_da_doc_ngay_tao")
  @@map("thong_bao")
}
