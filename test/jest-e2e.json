{
  "moduleFileExtensions": ["js", "json", "ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "rootDir": ".",
  "setupFiles": ["<rootDir>/jest-env.setup.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
